# Canonical production URL (no trailing slash). Used for metadata, sitemap and robots.
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Public enquiry address. When empty, enquiry CTAs fall back to the on-page
# contact section and show a clearly marked "pending" state.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When empty, no
# third-party script is loaded; events are still emitted as DOM events.
NEXT_PUBLIC_GA_ID=
